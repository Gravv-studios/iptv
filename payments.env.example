# Modelo sem credenciais. Copie para .env.local apenas na sua máquina.
# Na Vercel, configure estas variáveis diretamente em Settings > Environment Variables.
PAYMENTS_ENABLED=false
MP_MODE=test
APP_URL=https://iptv-nine-drab.vercel.app
MP_PUBLIC_KEY=
# Orders usa credenciais APP_USR inclusive para o vendedor de teste.
# Não misturar Public Key e Access Token de contas/ambientes diferentes.
MP_ACCESS_TOKEN=
MP_COLLECTOR_ID=
MP_WEBHOOK_SECRET=
PAYMENTS_SESSION_SECRET=
DATABASE_URL=
